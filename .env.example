# IntelliFlow - example configuration
#
# Copy to `.env` and fill in the values you need. `.env` is gitignored and must
# never be committed. Every value below is a placeholder.
#
# The application reads the real process environment first and falls back to
# `.env`, so exporting a variable always wins over the file.

# ── Required for /chat ─────────────────────────────────────────────
# Conversation memory. There is no offline substitute: the graph is compiled
# with a Postgres checkpointer, so POST /chat returns 503 without this.
# GET /health does not need it.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── LLM (NVIDIA NIM) — environment-dependent ───────────────────────
# Required to generate answers. The agent cannot produce a reply without a
# chat model; routing, validation, health, and the RAG tests do not need it.
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b

# ── Embeddings / RAG — local default needs no credential ───────────
# local  = sentence-transformers/all-MiniLM-L6-v2, 384-dim, runs on CPU.
#          This is the default and requires no API key.
# nvidia = NVIDIA NIM embeddings, 1024-dim. Needs NVIDIA_API_KEY.
# openai  = text-embedding-3-small, 1536-dim. Needs OPENAI_API_KEY.
EMBEDDING_PROVIDER=local
# Optional override of the provider's default model.
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
#
# The vector dimension depends on the provider. A store index is built for
# exactly one dimension, so switching providers requires a new index.
#
# memory   = in-process store. No credentials, but per-process: documents
#           ingested by the CLI are not visible to a running server.
# pinecone = persistent hosted store. Needs the Pinecone keys below.
VECTOR_STORE=memory

# Minimum cosine similarity for a chunk to count as evidence. Below this the
# agent is told the documents do not cover the topic rather than being handed
# a weak near-miss. Measured against all-MiniLM-L6-v2: on-topic paraphrases
# score ~0.49-0.73, unrelated queries score <0.05.
RETRIEVAL_THRESHOLD=0.30
RETRIEVER_K=5
RETRIEVER_FETCH_K=20

# Ingestion chunking (characters per chunk, and the overlap between them).
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# ── Vector DB (Pinecone) — only when VECTOR_STORE=pinecone ─────────
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=vector

# ── Web Search (Tavily) — environment-dependent ────────────────────
# Optional. Without it the search_web tool returns an explicit
# "web search is not configured" notice instead of failing the turn.
TAVILY_API_KEY=your_tavily_api_key

# ── MCP Server — environment-dependent ─────────────────────────────
# Optional. Leave empty to run without MCP tools; the graph still builds and
# RAG, web search, and direct answers all work. Set it to your own MCP server
# to expose a code-execution tool. This project does not ship a server and
# does not point at a third party's deployment.
MCP_SERVER_URL=

# ── API limits — optional ──────────────────────────────────────────
MAX_QUERY_CHARS=4000
MAX_IMAGE_BASE64_CHARS=5000000
DEFAULT_THREAD_ID=1
LOG_LEVEL=INFO

# ── Observability (LangSmith) — optional ───────────────────────────
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=intelliflow
LANGCHAIN_TRACING_V2=false

# ── Agent tuning — optional ────────────────────────────────────────
# Upper bound on tool-calling iterations per turn.
MAX_ITERATIONS=3
